# 복사해서 사용: cp .env.example .env
# ── LLM ─────────────────────────────────────────────────────────────
# 비워 두면 mock 모드(규칙·템플릿, 외부 호출 없음)로 동작합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-2
# auto = 키가 있으면 anthropic, 없으면 내부 엔드포인트, 둘 다 없으면 mock
LLM_PROVIDER=auto
# 내부 GPU/NPU 추론 서버(OpenAI 호환). 예: http://host.docker.internal:8001/v1
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=internal-model
INTERNAL_LLM_API_KEY=
# 단가(USD / 100만 토큰) — 비용 집계용
LLM_PRICE_IN_PER_MTOK=8
LLM_PRICE_OUT_PER_MTOK=40
# 고객 월 예산 초과 시 mock 으로 대체(1) 또는 오류(0)
BUDGET_FALLBACK_TO_MOCK=1

# ── 보안(데모 기본값 — 운영에서는 반드시 변경) ──────────────────────
JWT_SECRET=change-me-demo-secret-at-least-32-bytes-long
RELEASE_WEBHOOK_TOKEN=demo-webhook-token
POSTGRES_PASSWORD=aiact

# ── 운영 ────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=1
GOLDEN_THRESHOLD=0.9
EVIDENCE_RETENTION_YEARS=5

# ── 포트(호스트) ─────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
DEMO_PORT=8081
